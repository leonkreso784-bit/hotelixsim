{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/schema.d.ts",
      "!**/dist",
      "!**/target",
      "!openapi.json",
      "!.sqlx",
      "!**/tests/fixtures",
      "!**/tests/fixtures_v2"
    ]
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } }
}
