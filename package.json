{
  "name": "hotelixsim",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gen:openapi": "node scripts/gen-openapi.mjs",
    "gen:api": "node scripts/pnpm.mjs gen:openapi && node scripts/pnpm.mjs --filter @hotelixsim/api-client gen",
    "check:api": "node scripts/pnpm.mjs gen:api && node scripts/check-clean.mjs openapi.json packages/api-client/src",
    "check:docs": "node scripts/check-docs.mjs",
    "test:docs": "node --test \"scripts/*.test.mjs\"",
    "docs:plan": "node scripts/razdvoji-plan.mjs",
    "docs:adr": "node scripts/adr.mjs indeks",
    "lint": "biome check .",
    "typecheck": "node scripts/pnpm.mjs -r typecheck",
    "test": "node scripts/pnpm.mjs -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "5.9.3"
  }
}
