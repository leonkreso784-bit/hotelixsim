DATABASE_URL=postgres://hotelixsim:hotelixsim_lokalno@localhost:5433/hotelixsim
HOTELIXSIM_ADDR=127.0.0.1:8080
# Gradnja koristi spremljene podatke iz .sqlx/ (bez žive baze); vidi README, Lokalni razvoj.
SQLX_OFFLINE=true
# HOTELIXSIM_CONTENT=content/hotel
# Claude API ključ za presude, likove i mentora (nikad u git!). Prazno = igra radi na rezervama.
ANTHROPIC_API_KEY=
# Zadani modeli (ADR-024); ovdje ih se nadjačava:
# HOTELIXSIM_AI_MODEL_PRESUDA=claude-sonnet-5-5
# HOTELIXSIM_AI_MODEL_LIK=claude-haiku-5-5
# HOTELIXSIM_AI_MODEL_MENTOR=claude-sonnet-5-5
# Vrata poslužitelja (pilot). Lokalno sve izostavi: bez lozinke nema vrata, web se poslužuje s Viteom.
# HOTELIXSIM_PRODUKCIJA=1 = produkcijski način: start se odbija bez HOTELIXSIM_LOZINKA, HOTELIXSIM_WEB i DATABASE_URL; kolačić je Secure.
# HOTELIXSIM_PRODUKCIJA=
# Lozinka cijele stranice (Basic Auth; korisničko ime je bilo koje). Postavlja se samo u okolini, nikad u git.
# HOTELIXSIM_LOZINKA=
# Mapa izgrađenog weba (apps/web/dist) koju Rust poslužuje.
# HOTELIXSIM_WEB=
